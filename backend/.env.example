AWS_REGION=eu-west-1
AWS_PROFILE=lab_cli_user
DYNAMODB_TABLE_NAME=AppTable
S3_BUCKET_NAME=ccbda-app-bucket
ENVIRONMENT=dev
JOB_PROCESSING_QUEUE_URL=https://sqs.eu-west-1.amazonaws.com/<ACCOUNT_ID>/ccbda-job-processing
BEDROCK_MODEL_ID=eu.anthropic.claude-haiku-4-5-20251001-v1:0
COGNITO_USER_POOL_ID=eu-west-1_xxxxxxxxx
COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# Set to 1 to bypass Cognito and authenticate every request as 'dev-user-id'.
# Local development only — never set in deployed environments.
AUTH_BYPASS=0
